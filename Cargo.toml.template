# versions or URLs: verify with `cargo metadata` after copying.

[package]
name = "<YOUR_MODULE_CRATE_NAME>"
version = "0.1.0"
edition = "2021"
license = "MIT AND Apache-2.0"
description = "<ONE_LINE_DESCRIPTION_OF_YOUR_MODULE>"

[lib]
path = "src/lib.rs"

[[example]]
name = "register_and_search"
path = "examples/register_and_search.rs"

[dependencies]
# The published repo, not a crates.io release:
registry_core = { git = "https://github.com/goldennftplatform-svg/proclaim" }

